<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Id="SSMSPlus.4018b534-92e2-4cc5-abf6-f526817da0d9" Version="7.0.0" Language="en-US" Publisher="Adel KARZAZI" />
        <DisplayName>SSMSPlus</DisplayName>
        <Description xml:space="preserve">Useful extensions for SSMS 21 / SSMS 22 (query history, schema search, document export).</Description>
        <MoreInfo>https://github.com/austinkwilliams/SSMSPlus</MoreInfo>
        <Tags>ssms sql history search export</Tags>
    </Metadata>
    <Installation>
        <!-- SSMS product version range (not VS shell). Canonical form used by ErikEJ SqlCeToolbox / SSMS Gallery. -->
        <InstallationTarget Id="Microsoft.VisualStudio.Ssms" Version="[21.0,23.0)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
        <InstallationTarget Id="Microsoft.VisualStudio.Ssms" Version="[21.0,23.0)">
            <ProductArchitecture>arm64</ProductArchitecture>
        </InstallationTarget>
    </Installation>
    <Dependencies>
        <Dependency d:Source="Manual" Version="[4.8,)" DisplayName="Microsoft .NET Framework" Id="Microsoft.Framework.NDP" />
    </Dependencies>
    <Prerequisites>
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
    </Prerequisites>
    <Assets>
        <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    </Assets>
</PackageManifest>
